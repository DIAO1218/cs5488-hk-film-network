    >
        <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#6B6A66', letterSpacing: 0.8 }}>
            NOT AGAIN
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6A66', lineHeight: 1.65 }}>
            Running PageRank in parallel at 10⁵ edges
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6A66', lineHeight: 1.65 }}>
            Spawning a process pool per stage
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6A66', lineHeight: 1.65 }}>
            Treating a release region as a production country
        </Text>
    </Box>

    <Box
        style={{
            position: 'absolute',
